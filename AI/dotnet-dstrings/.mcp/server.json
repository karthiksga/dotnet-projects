{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.chrisnas/dotnet-dstrings",
  "description": "Analyzes duplicated strings in .NET processes or memory dumps with per-generation heap statistics",
  "title": "Duplicated Strings Analyzer",
  "websiteUrl": "https://www.nuget.org/packages/dotnet-dstrings",
  "repository": {
    "url": "https://github.com/chrisnas/DebuggingExtensions",
    "source": "github",
    "subfolder": "src/dotnet-dstrings"
  },
  "version": "2.1.0",
  "packages": [
    {
      "registryType": "nuget",
      "registryBaseUrl": "https://api.nuget.org/v3/index.json",
      "identifier": "dotnet-dstrings",
      "version": "2.1.0",
      "runtimeHint": "dnx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "--mcp"
        }
      ]
    }
  ],
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "installation": "dotnet tool install -g dotnet-dstrings",
      "note": "runtimeHint 'dnx' requires .NET 10+ SDK. On older SDKs, install the tool globally first."
    }
  }
}
